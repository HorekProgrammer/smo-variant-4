@startuml
title Событийный алгоритм — вариант 4
start
:Извлечь ближайшее событие;
if (Генерация?) then (да)
  :Создать заявку и запланировать следующую (ИЗ2);
  if (Буфер полон?) then (да)
    :Вытеснить последнюю поступившую заявку (Д1ОО4);
  endif
  :Записать по кольцу (Д1ОЗ1);
else (завершение)
  :Освободить прибор;
endif
while (Есть заявка и свободный прибор?) is (да)
  :Выбрать источник по приоритету,
  внутри него последнюю заявку (Д2Б4);
  :Выбрать прибор по кольцу (Д2П2);
  :Запланировать завершение (ПЗ1);
endwhile (нет)
:Показать календарь, буфер и состояние (ОД1);
stop
@enduml

